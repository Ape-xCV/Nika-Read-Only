+#if 1  // NIKA begin
+	mov SVM_current_vmcb(%_ASM_DI), %_ASM_SI      /* RSI = svm->current_vmcb (struct kvm_vmcb_info *) */
+	mov KVM_VMCB_ptr(%_ASM_SI), %_ASM_CX          /* RCX = current_vmcb->ptr (struct vmcb *) = &vmcb->control */
+
+	/* CHECK: IDT_VECTORING_INFO_FIELD (svm_complete_interrupts guard) */
+	movl VMCB_CONTROL_exit_int_info(%_ASM_CX), %edx         /* RDX = control->exit_int_info */
+	test $0x80000000, %edx                                  /* Test VALID (bit 31) */
+	jnz .Lfastpath_slowpath
+
+	/* CHECK: GUEST_INTERRUPTIBILITY_INFO for STI or MOV SS blocking */
+	movl VMCB_CONTROL_int_state(%_ASM_CX), %edx   /* RDX = control->int_state */
+	test $0x03, %edx                              /* Test GUEST_INTR_STATE_STI (bit 0) | GUEST_INTR_STATE_MOV_SS (bit 1) */
+	jnz .Lfastpath_slowpath
+
+	mov VMCB_SAVE_rflags + VMCB_save(%_ASM_CX), %_ASM_DX    /* Read GUEST_RFLAGS */
+	test $0x100, %_ASM_DX                                   /* Test X86_EFLAGS_TF (bit 8) */
+	jnz .Lfastpath_slowpath
+
+	movl VMCB_CONTROL_exit_code(%_ASM_CX), %edx   /* RDX = control->exit_code */
+	cmp $0x08A, %edx                              /* SVM_EXIT_MONITOR (0x08A) == RDX 'w' lower 16 bits */
+	je .Ladvance_rip_and_reenter
+	cmp $0x08B, %edx                              /* SVM_EXIT_MWAIT (0x08B) */
+	jne .Lfastpath_slowpath
+
+.Ladvance_rip_and_reenter:
+	mov VMCB_CONTROL_next_rip(%_ASM_CX), %_ASM_DX           /* RDX = control->next_rip */
+	mov %_ASM_DX, VMCB_SAVE_rip + VMCB_save(%_ASM_CX)       /* Write save->rip */
+.Lreload_and_reenter:
+
+	/* Reload GPRs from &vcpu->arch.regs (%_ASM_DI) */
+#ifdef CONFIG_X86_64
+	mov VCPU_R8 (%_ASM_DI), %r8
+	mov VCPU_R9 (%_ASM_DI), %r9
+	mov VCPU_R10(%_ASM_DI), %r10
+	mov VCPU_R11(%_ASM_DI), %r11
+	mov VCPU_R12(%_ASM_DI), %r12
+	mov VCPU_R13(%_ASM_DI), %r13
+	mov VCPU_R14(%_ASM_DI), %r14
+	mov VCPU_R15(%_ASM_DI), %r15
+#endif
+	mov VCPU_RCX(%_ASM_DI), %_ASM_CX
+	mov VCPU_RDX(%_ASM_DI), %_ASM_DX
+	mov VCPU_RBX(%_ASM_DI), %_ASM_BX
+	mov VCPU_RBP(%_ASM_DI), %_ASM_BP
+
+	mov KVM_VMCB_pa(%_ASM_SI), %_ASM_AX           /* Load current VMCB physical address into RAX as required by VMRUN */
+	mov VCPU_RSI(%_ASM_DI), %_ASM_SI
+
+	push %_ASM_DI                                 /* Push @svm back to balance pop %_ASM_AX after exit */
+	mov VCPU_RDI(%_ASM_DI), %_ASM_DI              /* MUST BE LAST: Reload guest RDI from memory (overwriting our @regs pointer) */
+
+	/* Execute VMRUN to return directly to guest execution loop */
+	jmp 3b
+
+.Lfastpath_slowpath:
+#endif  // NIKA end
 
 	mov SVM_vmcb01_pa(%_ASM_DI), %_ASM_AX
 5:	vmsave %_ASM_AX
