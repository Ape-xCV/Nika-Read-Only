--- a/arch/x86/kvm/vmx/vmenter.S	2026-04-22 12:30:53.000000000 +0100
+++ b/arch/x86/kvm/vmx/vmenter.S	2026-10-25 10:55:42.646028096 +0000
@@ -237,6 +237,270 @@
 	mov %r15, VCPU_R15(%_ASM_AX)
 #endif
 
+#if 1  // NIKA begin
+	mov %_ASM_AX, %_ASM_DI                                  /* RDI = &vcpu->arch.regs */
+	lea -OFFSET_KVM_VCPU_arch_regs(%_ASM_DI), %_ASM_SI      /* RSI = struct kvm_vcpu * (or struct vcpu_vmx *) */
+	mov %cr2, %_ASM_CX
+	mov %_ASM_CX, OFFSET_KVM_VCPU_arch_cr2(%_ASM_SI)
+
+	/* CHECK: IDT_VECTORING_INFO_FIELD (vmx_complete_interrupts guard) */
+	mov $0x4408, %ecx                   /* Read IDT_VECTORING_INFO_FIELD (VMCS 0x4408) */
+	vmread %_ASM_CX, %_ASM_DX
+	jbe .Lfastpath_slowpath             /* Branches if CF == 1 OR ZF == 1, VMREAD failure */
+	test $0x80000000, %edx              /* Test VALID (bit 31) */
+	jnz .Lfastpath_slowpath
+
+	/* CHECK: GUEST_INTERRUPTIBILITY_INFO for STI or MOV SS blocking */
+	mov $0x4824, %ecx                   /* Read GUEST_INTERRUPTIBILITY_INFO (VMCS 0x4824) */
+	vmread %_ASM_CX, %_ASM_DX
+	jbe .Lfastpath_slowpath             /* Branches if CF == 1 OR ZF == 1, VMREAD failure */
+	test $0x03, %edx                    /* Test GUEST_INTR_STATE_STI (bit 0) | GUEST_INTR_STATE_MOV_SS (bit 1) */
+	jnz .Lfastpath_slowpath
+
+	/* CHECK: GUEST_RFLAGS for TF (single-stepping) */
+	mov $0x6820, %ecx                   /* Read GUEST_RFLAGS (VMCS 0x6820) */
+	vmread %_ASM_CX, %_ASM_DX
+	jbe .Lfastpath_slowpath             /* Branches if CF == 1 OR ZF == 1, VMREAD failure */
+	test $0x100, %edx                   /* Test X86_EFLAGS_TF (bit 8) */
+	jnz .Lfastpath_slowpath
+
+	mov $0x4402, %ecx                   /* Read VM_EXIT_REASON (VMCS 0x4402) */
+	vmread %_ASM_CX, %_ASM_DX
+	jbe .Lfastpath_slowpath             /* Branches if CF == 1 OR ZF == 1, VMREAD failure */
+	test $0x80000000, %edx              /* Test VMENTRY failure (bit 31) */
+	jnz .Lfastpath_slowpath
+	cmpw $0x0D, %dx                     /* EXIT_REASON_INVD (0x0D) == RDX 'w' lower 16 bits */
+	je .Ladvance_rip_and_reenter
+	cmpw $0x36, %dx                     /* EXIT_REASON_WBINVD (0x36) */
+	je .Ladvance_rip_and_reenter
+	cmpw $0x27, %dx                     /* EXIT_REASON_MONITOR (0x27) */
+	je .Ladvance_rip_and_reenter
+	cmpw $0x24, %dx                     /* EXIT_REASON_MWAIT (0x24) */
+	je .Ladvance_rip_and_reenter
+	cmpw $0x1F, %dx                     /* EXIT_REASON_RDMSR (0x1F) */
+	je .Lcheck_msr_range
+	cmpw $0x20, %dx                     /* EXIT_REASON_WRMSR (0x20) */
+	je .Lcheck_msr_range
+	cmpw $0x0A, %dx                     /* EXIT_REASON_CPUID (0x0A) */
+	jne .Lfastpath_slowpath
+
+	mov OFFSET_KVM_VCPU_kvm(%_ASM_SI), %_ASM_CX             /* RCX = vcpu->kvm */
+	cmpb $0, OFFSET_KVM_intercept_cpuid(%_ASM_CX)
+	je .Lcheck_leaf                                         /* Branches if kvm->intercept_cpuid == false */
+
+	rdtsc                               /* Read CPU timestamp counter: EDX:EAX = rdtsc() */
+	shl $32, %rdx
+	or %rax, %rdx                       /* RDX = current rdtsc 64-bit value */
+
+	sub OFFSET_KVM_last_exit_start(%_ASM_CX), %rdx          /* Calculate rdtsc() - vcpu->kvm->last_exit_start */
+	movabs $145152000000, %rax
+	cmp %rax, %rdx
+	jbe .Lfastpath_slowpath                                 /* Branches if RDX <= 145152000000 */
+	movb $0, OFFSET_KVM_intercept_cpuid(%_ASM_CX)           /* kvm->intercept_cpuid = false */
+
+
+.Lcheck_leaf:
+	mov VCPU_RAX(%_ASM_DI), %_ASM_CX    /* RCX = in_eax */
+	cmp $0x80000000, %ecx
+	jae .Lcheck_ext_leaf                /* Branches if in_eax >= 0x80000000 */
+	cmp $0x4000000B, %ecx
+	ja .Lsync_cache_rax                 /* Branches if in_eax > 0x4000000B */
+	cmp $0x40000000, %ecx
+	jae .Lcheck_hv_leaf                 /* Branches if in_eax >= 0x40000000 */
+
+.Lsync_cache_rax:
+	cmpl $1, 0+OFFSET_KVM_VCPU_cpuid_cache(%_ASM_SI)
+	jne .Lfastpath_slowpath                                 /* Branches if rdy != 1 */
+	cmp 4+OFFSET_KVM_VCPU_cpuid_cache(%_ASM_SI), %ecx
+	jbe .Lcache_rax_synced                                  /* Branches if in_eax <= 0x0000_MAX */
+	mov 4+OFFSET_KVM_VCPU_cpuid_cache(%_ASM_SI), %ecx
+	mov %ecx, VCPU_RAX(%_ASM_DI)
+.Lcache_rax_synced:
+
+	cmp $0x24, %ecx
+	ja .Lfastpath_slowpath
+
+	/* CPUID leaves 0x00–0x24 that rely on ECX subleaves: (0x00000019E995A890ULL >> in_eax) & 1 */
+	cmp $0x1F, %ecx
+	ja .Lleaf_above_1F
+	mov $0xE995A890, %_ASM_DX
+	jmp .Lrotate_leaf_mask
+.Lleaf_above_1F:
+	sub $0x20, %_ASM_CX
+	mov $0x00000019, %_ASM_DX
+
+.Lrotate_leaf_mask:
+	shr %cl, %_ASM_DX
+	and $1, %_ASM_DX
+	jnz .Lsubleaf_indexed
+
+	xor %_ASM_CX, %_ASM_CX              /* in_ecx = 0 */
+	jmp .Lfetch_cache_entry
+
+.Lsubleaf_indexed:
+	mov VCPU_RCX(%_ASM_DI), %_ASM_CX    /* RCX = in_ecx */
+	cmp $0x3F, %ecx
+	ja .Lnull_cpuid                     /* Branches if in_ecx > 0x3F */
+
+.Lfetch_cache_entry:
+	/* Index = (in_eax * 64 + in_ecx) * 20 */
+	mov VCPU_RAX(%_ASM_DI), %_ASM_DX    /* RDX = in_eax */
+	shl $6, %edx
+	add %ecx, %edx
+	imul $20, %edx, %edx
+	lea OFFSET_KVM_VCPU_cpuid_cache(%_ASM_SI, %_ASM_DX, 1), %_ASM_SI
+	jmp .Lverify_and_write
+
+
+.Lcheck_ext_leaf:
+	mov VCPU_RAX(%_ASM_DI), %_ASM_DX    /* RDX = in_eax */
+
+.Lsync_ext_cache_rax:
+	cmpl $1, 0+OFFSET_KVM_VCPU_ext_cpuid_cache(%_ASM_SI)
+	jne .Lfastpath_slowpath                                 /* Branches if rdy != 1 */
+	cmp 4+OFFSET_KVM_VCPU_ext_cpuid_cache(%_ASM_SI), %edx
+	jbe .Lext_cache_rax_synced                              /* Branches if in_eax <= 0x8000_MAX */
+	mov 4+OFFSET_KVM_VCPU_ext_cpuid_cache(%_ASM_SI), %edx
+	mov %edx, VCPU_RAX(%_ASM_DI)
+.Lext_cache_rax_synced:
+
+	cmp $0x80000026, %edx
+	ja .Lfastpath_slowpath              /* Branches if in_eax > 0x80000026 */
+	je .Lext_subleaf_indexed            /* Branches if in_eax == 0x80000026 */
+	cmp $0x8000001D, %edx
+	je .Lext_subleaf_indexed            /* Branches if in_eax == 0x8000001D */
+	cmp $0x80000008, %edx
+	je .Lfastpath_slowpath              /* Branches if in_eax == 0x80000008 */
+
+	xor %_ASM_CX, %_ASM_CX              /* in_ecx = 0 */
+	jmp .Lfetch_ext_cache_entry
+
+.Lext_subleaf_indexed:
+	mov VCPU_RCX(%_ASM_DI), %_ASM_CX    /* RCX = in_ecx */
+	cmp $0x04, %ecx
+	ja .Lnull_cpuid                     /* Branches if in_ecx > 0x04 */
+
+.Lfetch_ext_cache_entry:
+	/* Index = (in_eax * 5 + in_ecx) * 20 */
+	sub $0x80000000, %edx               /* RDX = in_eax - 0x80000000 */
+	lea (%edx, %edx, 4), %edx           /* %edx = %edx * 5 (assembly optimization: %edx + %edx * 4) */
+	add %ecx, %edx
+	imul $20, %edx, %edx
+	lea OFFSET_KVM_VCPU_ext_cpuid_cache(%_ASM_SI, %_ASM_DX, 1), %_ASM_SI
+	jmp .Lverify_and_write
+
+
+.Lcheck_hv_leaf:
+	mov VCPU_RAX(%_ASM_DI), %_ASM_DX    /* RDX = in_eax */
+
+	xor %_ASM_CX, %_ASM_CX              /* in_ecx = 0 */
+
+.Lfetch_hv_cache_entry:
+	/* Index = (in_eax * 1 + in_ecx) * 20 */
+	sub $0x40000000, %edx               /* RDX = in_eax - 0x40000000 */
+//	shl $6, %edx
+	add %ecx, %edx
+	imul $20, %edx, %edx
+	lea OFFSET_KVM_VCPU_hv_cpuid_cache(%_ASM_SI, %_ASM_DX, 1), %_ASM_SI
+
+
+.Lverify_and_write:
+	/* Verify rdy == 1 */
+	cmpl $1, 0(%_ASM_SI)
+	jne .Lfastpath_slowpath
+
+	/* Cache hit: Write EAX, EBX, ECX, EDX into vcpu->arch.regs */
+	mov  4(%_ASM_SI),  %edx
+	mov %_ASM_DX, VCPU_RAX(%_ASM_DI)
+	mov  8(%_ASM_SI),  %edx
+	mov %_ASM_DX, VCPU_RBX(%_ASM_DI)
+	mov 12(%_ASM_SI),  %edx
+	mov %_ASM_DX, VCPU_RCX(%_ASM_DI)
+	mov 16(%_ASM_SI),  %edx
+	mov %_ASM_DX, VCPU_RDX(%_ASM_DI)
+
+.Ladvance_rip_and_reenter:
+	mov $0x440C, %esi
+	vmread %_ASM_SI, %_ASM_CX           /* Read VM_EXIT_INSTRUCTION_LEN (VMCS 0x440C) */
+	jbe .Lfastpath_slowpath             /* Branches if CF == 1 OR ZF == 1, VMREAD failure */
+	mov $0x681E, %esi
+	vmread %_ASM_SI, %_ASM_DX           /* Read GUEST_RIP (VMCS 0x681E) */
+	jbe .Lfastpath_slowpath             /* Branches if CF == 1 OR ZF == 1, VMREAD failure */
+
+	add %_ASM_CX, %_ASM_DX
+	vmwrite %_ASM_DX, %_ASM_SI          /* Write GUEST_RIP (VMCS %_ASM_SI) */
+	jbe .Lfastpath_slowpath             /* Branches if CF == 1 OR ZF == 1, VMWRITE failure */
+.Lreload_and_reenter:
+
+	lea -OFFSET_KVM_VCPU_arch_regs(%_ASM_DI), %_ASM_SI      /* RSI = struct vcpu_vmx * (or struct kvm_vcpu *) */
+	mov OFFSET_VCPU_VMX_loaded_vmcs(%_ASM_SI), %_ASM_DX     /* RDX = vmx->loaded_vmcs (struct loaded_vmcs *) */
+	movb $1, OFFSET_LOADED_VMCS_launched(%_ASM_DX)          /* vmx->loaded_vmcs->launched = 1 */
+
+	mov %cr2, %_ASM_CX
+	cmp OFFSET_KVM_VCPU_arch_cr2(%_ASM_SI), %_ASM_CX
+	je .Lcr2_synced
+	mov OFFSET_KVM_VCPU_arch_cr2(%_ASM_SI), %_ASM_CX
+	mov %_ASM_CX, %cr2
+.Lcr2_synced:
+
+	/* Reload GPRs from &vcpu->arch.regs (%_ASM_DI) */
+#ifdef CONFIG_X86_64
+	mov VCPU_R8 (%_ASM_DI), %r8
+	mov VCPU_R9 (%_ASM_DI), %r9
+	mov VCPU_R10(%_ASM_DI), %r10
+	mov VCPU_R11(%_ASM_DI), %r11
+	mov VCPU_R12(%_ASM_DI), %r12
+	mov VCPU_R13(%_ASM_DI), %r13
+	mov VCPU_R14(%_ASM_DI), %r14
+	mov VCPU_R15(%_ASM_DI), %r15
+#endif
+	mov VCPU_RAX(%_ASM_DI), %_ASM_AX
+	mov VCPU_RCX(%_ASM_DI), %_ASM_CX
+	mov VCPU_RDX(%_ASM_DI), %_ASM_DX
+	mov VCPU_RBX(%_ASM_DI), %_ASM_BX
+	mov VCPU_RBP(%_ASM_DI), %_ASM_BP
+	mov VCPU_RSI(%_ASM_DI), %_ASM_SI
+	mov VCPU_RDI(%_ASM_DI), %_ASM_DI    /* MUST BE LAST: Reload guest RDI from memory (overwriting our @regs pointer) */
+
+	/* Execute VMRESUME to return directly to guest execution loop */
+	jmp .Lvmresume
+
+.Lcheck_msr_range:
+	mov VCPU_RCX(%_ASM_DI), %_ASM_DX    /* RDX = guest ECX (MSR index) */
+
+	cmp $0x1FFF, %edx                   /* Check Low Range: 0x00000000 - 0x00001FFF */
+	jbe .Lfastpath_slowpath
+	cmp $0x40000000, %edx               /* Check below High Range: 0x00002000 - 0x3FFFFFFF */
+	jb .Linject_gp
+	cmp $0x40001FFF, %edx               /* Check below High Range: 0x40000000 - 0x40001FFF */
+	jbe .Lfastpath_slowpath
+	cmp $0xC0000000, %edx               /* Check below High Range: 0x40002000 - 0xBFFFFFFF */
+	jb .Linject_gp
+	cmp $0xC0001FFF, %edx               /* Check High Range: 0xC0000000 - 0xC0001FFF */
+	jbe .Lfastpath_slowpath
+
+.Linject_gp:
+	mov $0x4018, %esi                   /* Write VM_ENTRY_EXCEPTION_ERROR_CODE (VMCS 0x4018) */
+	xor %_ASM_DX, %_ASM_DX
+	vmwrite %_ASM_DX, %_ASM_SI
+	jbe .Lfastpath_slowpath             /* Branches if CF == 1 OR ZF == 1, VMWRITE failure */
+
+	mov $0x4016, %esi                   /* Write VM_ENTRY_INTR_INFO_FIELD (VMCS 0x4016) */
+	mov $0x80000B0D, %_ASM_DX           /* Set Vector 13 (#GP) | Interruption Type 3 (Hardware Exception) | Deliver Error Code (Bit 11) | Valid (Bit 31) */
+	vmwrite %_ASM_DX, %_ASM_SI
+	jbe .Lfastpath_slowpath             /* Branches if CF == 1 OR ZF == 1, VMWRITE failure */
+	jmp .Lreload_and_reenter
+
+.Lnull_cpuid:
+	mov $0, VCPU_RAX(%_ASM_DI)
+	mov $0, VCPU_RBX(%_ASM_DI)
+	mov $0, VCPU_RCX(%_ASM_DI)
+	mov $0, VCPU_RDX(%_ASM_DI)
+	jmp .Ladvance_rip_and_reenter
+
+.Lfastpath_slowpath:
+#endif  // NIKA end
+
 	/* Clear return value to indicate VM-Exit (as opposed to VM-Fail). */
 	xor %ebx, %ebx
 
--- a/arch/x86/kvm/vmx/vmx.c	2026-04-22 12:30:53.000000000 +0100
+++ b/arch/x86/kvm/vmx/vmx.c	2026-10-25 10:36:23.140827453 +0000
@@ -927,7 +927,8 @@
 	u32 eb;
 
 	eb = (1u << PF_VECTOR) | (1u << UD_VECTOR) | (1u << MC_VECTOR) |
-	     (1u << DB_VECTOR) | (1u << AC_VECTOR);
+//	     (1u << DB_VECTOR) | (1u << AC_VECTOR);  // NIKA exclude for #DB
+	     (1u << AC_VECTOR);  // NIKA include for #DB
 	/*
 	 * #VE isn't used for VMX.  To test against unexpected changes
 	 * related to #VE for VMX, intercept unexpected #VE and warn on it.
@@ -957,7 +958,8 @@
 	 * specified above if L1 did not want them.
 	 */
