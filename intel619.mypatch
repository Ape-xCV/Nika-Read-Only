+static int handle_cpuid(struct kvm_vcpu *vcpu)  // NIKA begin
+{
+	u32 eax, ebx, ecx, edx, in_eax, in_ecx;
+//	if (cpuid_fault_enabled(vcpu) && !kvm_require_cpl(vcpu, 0))
+//		return 1;
+	eax = kvm_rax_read(vcpu);
+	ecx = kvm_rcx_read(vcpu);
+	in_eax = eax;
+	in_ecx = ecx;
+	kvm_cpuid(vcpu, &eax, &ebx, &ecx, &edx, false);
+	if (//in_eax != 0x00       &&  // Maximum Basic Leaf / CPU Vendor ID String
+//		in_eax != 0x80000000 &&  // Maximum Extended Leaf
+//		in_eax != 0x01       &&  // Basic Processor Info / Signature / Feature Flags
+//		in_eax != 0x80000001 &&  // Extended Processor Info / Feature Flags
+//		in_eax != 0x02       &&  // Legacy Cache and TLB Descriptor Information
+//		in_eax != 0x04       &&  // [Intel] Deterministic Cache Parameters
+//		in_eax != 0x8000001D &&  // [AMD] Cache Properties / Deterministic Cache Parameters
+		in_eax != 0x06       &&  // Thermal and Power Management Features
+//		in_eax != 0x07       &&  // Structured Extended Feature Flags (subleafs: AVX2, AVX-512, etc.)
+//		in_eax != 0x0A       &&  // Architectural Performance Monitoring (PMU)
+		in_eax != 0x0B       &&  // Extended Topology Enumeration (logical processors, SMT, and x2APIC IDs)
+		in_eax != 0x1F       &&  // [Intel] V2 Extended Topology Enumeration
+		in_eax != 0x8000001E &&  // [AMD] Processor Topology / Extended APIC and Node IDs
+		in_eax != 0x80000026 &&  // [AMD] Extended CPU Topology Enumeration
+//		in_eax != 0x0D       &&  // Processor Extended State Enumeration (XSAVE / XRSTOR)
+//		in_eax != 0x12       &&  // [Intel] Software Guard Extensions (SGX) Capabilities
+//		in_eax != 0x14       &&  // [Intel] Processor Trace (Intel PT) Capabilities
+//		in_eax != 0x1D       &&  // [Intel] AMX Tile Information (tile palettes and dimensions)
+//		in_eax != 0x1E       &&  // [Intel] AMX TMUL Information (tile matrix multiplication)
+//		in_eax != 0x24       &&  // [Intel] AVX10 Feature Enumeration
+	//	in_eax != 0x80000008 &&  // Extended Processor Info / Address Sizes (physical and linear address widths)
+		in_eax != 0x80000002 &&  // Extended Brand String (bytes  0-15)
+		in_eax != 0x80000003 &&  // Extended Brand String (bytes 16-31)
+		in_eax != 0x80000004)    // Extended Brand String (bytes 32-47)
+		asm volatile("cpuid"
+		: "=a"(eax), "=b"(ebx), "=c"(ecx), "=d"(edx)
+		: "a"(in_eax), "c"(in_ecx)
+//		: "memory"
+		);
+	if (in_eax == 0x01) {
+		ecx &= ~(1U << 3);  // Clear MONITOR_MWAIT (bit 3)
+		if (nested) ecx |= 1U << 31;  // Hyper-V fix
+	}
+	if (in_eax == 0x07 && in_ecx == 0x00) ecx &= ~(1U << 13);  // Clear TME (bit 13)
+	if (in_eax == 0x07 && in_ecx == 0x01) eax &= ~(1U << 22);  // Clear HRESET (bit 22)
+	kvm_rax_write(vcpu, eax);
+	kvm_rbx_write(vcpu, ebx);
+	kvm_rcx_write(vcpu, ecx);
+	kvm_rdx_write(vcpu, edx);
+	if (in_eax < 0x40000000 || in_eax > 0x4000000B && in_eax < 0x80000000) {
+		if (vcpu->cpuid_cache[0x00][0x00].rdy == 1)          in_eax = min(in_eax, vcpu->cpuid_cache[0x00][0x00].eax);
+		else                                                 in_eax = min(in_eax, 0x24);
+		// Mask representing CPUID leaves 0x00–0x24 that rely on ECX subleaves
+		if (((0x00000019E995A890ULL >> in_eax) & 1ULL) == 0) in_ecx = 0;
+		else                                                 in_ecx = min(in_ecx, 0x3F);
+//		if ((in_eax == 0x01 || in_eax == 0x07 || in_eax == 0x0D)
+//			&& ((vcpu->arch.cr4 & X86_CR4_OSXSAVE) == 0 || (vcpu->arch.xcr0 & 0x06) != 0x06))
+//			return kvm_skip_emulated_instruction(vcpu);
+		vcpu->cpuid_cache[in_eax][in_ecx].rdy = 1;
+		vcpu->cpuid_cache[in_eax][in_ecx].eax = eax;
+		vcpu->cpuid_cache[in_eax][in_ecx].ebx = ebx;
+		vcpu->cpuid_cache[in_eax][in_ecx].ecx = ecx;
+		vcpu->cpuid_cache[in_eax][in_ecx].edx = edx;
+	}
+	else if (in_eax >= 0x80000000) {
+		if (vcpu->ext_cpuid_cache[0x00][0x00].rdy == 1)   in_eax = min(in_eax, vcpu->ext_cpuid_cache[0x00][0x00].eax);
+		else                                              in_eax = min(in_eax, 0x80000026);
+		if (in_eax != 0x8000001D && in_eax != 0x80000026) in_ecx = 0;
+		else                                              in_ecx = min(in_ecx, 0x04);
+		in_eax -= 0x80000000;
+		vcpu->ext_cpuid_cache[in_eax][in_ecx].rdy = 1;
+		vcpu->ext_cpuid_cache[in_eax][in_ecx].eax = eax;
+		vcpu->ext_cpuid_cache[in_eax][in_ecx].ebx = ebx;
+		vcpu->ext_cpuid_cache[in_eax][in_ecx].ecx = ecx;
+		vcpu->ext_cpuid_cache[in_eax][in_ecx].edx = edx;
+	}
+	return kvm_skip_emulated_instruction(vcpu);
+}  // NIKA end
+
 /*
