+				vcpu->arch.regs[VCPU_REGS_RBX] = vcpu->cpuid_cache[in_eax][in_ecx].ebx;
+				vcpu->arch.regs[VCPU_REGS_RCX] = vcpu->cpuid_cache[in_eax][in_ecx].ecx;
+				vcpu->arch.regs[VCPU_REGS_RDX] = vcpu->cpuid_cache[in_eax][in_ecx].edx;
+			} else goto reenter_guest_slow;
