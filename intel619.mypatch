+				if (vcpu->cpuid_cache[in_eax][in_ecx].rdy == 1) {
+					eax = vcpu->cpuid_cache[in_eax][in_ecx].eax;
+					ebx = vcpu->cpuid_cache[in_eax][in_ecx].ebx;
+					ecx = vcpu->cpuid_cache[in_eax][in_ecx].ecx;
+					edx = vcpu->cpuid_cache[in_eax][in_ecx].edx;
+					kvm_rax_write(vcpu, eax);
+					kvm_rbx_write(vcpu, ebx);
+					kvm_rcx_write(vcpu, ecx);
+					kvm_rdx_write(vcpu, edx);
+					return kvm_skip_emulated_instruction(vcpu);
+				}
+			}
+			else if (in_eax >= 0x80000000) {
+				if (vcpu->ext_cpuid_cache[0x00][0x00].rdy == 1)   in_eax = min(in_eax, vcpu->ext_cpuid_cache[0x00][0x00].eax);
+				else                                              in_eax = min(in_eax, 0x80000026);
+				if (in_eax != 0x8000001D && in_eax != 0x80000026) in_ecx = 0;
+				else                                              in_ecx = min(in_ecx, 0x04);
+				in_eax -= 0x80000000;
+				if (vcpu->ext_cpuid_cache[in_eax][in_ecx].rdy == 1) {
+					eax = vcpu->ext_cpuid_cache[in_eax][in_ecx].eax;
+					ebx = vcpu->ext_cpuid_cache[in_eax][in_ecx].ebx;
+					ecx = vcpu->ext_cpuid_cache[in_eax][in_ecx].ecx;
+					edx = vcpu->ext_cpuid_cache[in_eax][in_ecx].edx;
+					kvm_rax_write(vcpu, eax);
+					kvm_rbx_write(vcpu, ebx);
