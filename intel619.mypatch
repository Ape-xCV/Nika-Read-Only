 	kvm_wait_lapic_expire(vcpu);
 
+//	u32 in_eax, in_ecx;  // NIKA added
+//reenter_guest_fast:  // NIKA added
+
 	/* The actual VMENTER/EXIT is in the .noinstr.text section. */
 	vmx_vcpu_enter_exit(vcpu, __vmx_vcpu_run_flags(vmx));
+/*
+	if (vmx_get_exit_reason(vcpu).basic == EXIT_REASON_CPUID && !vcpu->kvm->intercept_cpuid) {  // NIKA begin
+//		if (unlikely(vmcs_read32(GUEST_INTERRUPTIBILITY_INFO) & (GUEST_INTR_STATE_STI | GUEST_INTR_STATE_MOV_SS)))
+//			goto reenter_guest_slow;  // If an NMI or interrupt is pending, we MUST hit the slow path
+
+		if (vmcs_readl(GUEST_RFLAGS) & X86_EFLAGS_TF)
+			goto reenter_guest_slow;
+
+		in_eax = vcpu->arch.regs[VCPU_REGS_RAX];
+		in_ecx = vcpu->arch.regs[VCPU_REGS_RCX];
+		if (in_eax == 0x01 || in_eax == 0x0B || in_eax == 0x1F) {
+			uint32_t smt_bits = 0;
+			while ((1U << smt_bits) < vcpu->kvm->threads_per_core) { smt_bits++; }
+			uint32_t core_bits = 0;
+			while ((1U << core_bits) < vcpu->kvm->cores_per_socket) { core_bits++; }
+
+			uint32_t thread_idx = vcpu->vcpu_id % vcpu->kvm->threads_per_core;
