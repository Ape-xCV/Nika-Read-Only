 /*
--- a/arch/x86/kvm/vmx/vmenter.S	2026-04-22 12:30:53.000000000 +0100
+++ b/arch/x86/kvm/vmx/vmenter.S	2026-09-03 22:59:40.843301083 +0100
@@ -237,6 +237,184 @@
 	mov %r15, VCPU_R15(%_ASM_AX)
 #endif
 
+#if 1  // NIKA begin
+	mov %_ASM_AX, %_ASM_DI              /* RDI = &vcpu->arch.regs */
+
+	/* CHECK: IDT_VECTORING_INFO_FIELD (vmx_complete_interrupts guard) */
+	mov $0x4408, %esi                   /* Read IDT_VECTORING_INFO_FIELD (VMCS 0x4408) */
+	vmread %_ASM_SI, %_ASM_DX
+	jbe .Lfastpath_slowpath             /* Branches if CF == 1 OR ZF == 1, VMREAD failure */
+	test $0x80000000, %edx              /* Test VALID (bit 31) */
+	jnz .Lfastpath_slowpath
+
+	/* CHECK: GUEST_INTERRUPTIBILITY_INFO for STI or MOV SS blocking */
+	mov $0x4824, %esi                   /* Read GUEST_INTERRUPTIBILITY_INFO (VMCS 0x4824) */
+	vmread %_ASM_SI, %_ASM_DX
+	jbe .Lfastpath_slowpath             /* Branches if CF == 1 OR ZF == 1, VMREAD failure */
+	test $0x03, %edx                    /* Test GUEST_INTR_STATE_STI (bit 0) | GUEST_INTR_STATE_MOV_SS (bit 1) */
+	jnz .Lfastpath_slowpath
+
+	mov $0x6820, %esi                   /* Read GUEST_RFLAGS (VMCS 0x6820) */
+	vmread %_ASM_SI, %_ASM_DX
+	jbe .Lfastpath_slowpath             /* Branches if CF == 1 OR ZF == 1, VMREAD failure */
+	test $0x100, %edx                   /* Test X86_EFLAGS_TF (bit 8) */
+	jnz .Lfastpath_slowpath
+
+	mov $0x4402, %esi                   /* Read VM_EXIT_REASON (VMCS 0x4402) */
+	vmread %_ASM_SI, %_ASM_DX
+	jbe .Lfastpath_slowpath             /* Branches if CF == 1 OR ZF == 1, VMREAD failure */
+	test $0x80000000, %edx              /* Test VMENTRY failure (bit 31) */
+	jnz .Lfastpath_slowpath
+	cmpw $0x1F, %dx                     /* EXIT_REASON_RDMSR (0x1F) */
+	je .Lcheck_msr_range
+	cmpw $0x20, %dx                     /* EXIT_REASON_WRMSR (0x20) */
+	je .Lcheck_msr_range
+//	cmpw $0x27, %dx                     /* EXIT_REASON_MONITOR (0x27) */
+//	je .Ladvance_rip_and_reenter
+//	cmpw $0x24, %dx                     /* EXIT_REASON_MWAIT (0x24) */
+//	je .Ladvance_rip_and_reenter
+	cmpw $0x0A, %dx                     /* EXIT_REASON_CPUID (0x0A) == RDX 'w' lower 16 bits */
+	jne .Lfastpath_slowpath
+
+
+.Lcheck_leaf:
+//	mov %_ASM_DI, %_ASM_SI                                  /* RSI = vcpu->arch.regs */
+//	sub $OFFSET_KVM_VCPU_ARCH_REGS, %_ASM_SI                /* RSI = struct kvm_vcpu * (or struct vcpu_vmx *) */
+	lea -OFFSET_KVM_VCPU_ARCH_REGS(%_ASM_DI), %_ASM_SI      /* RSI = struct kvm_vcpu * (or struct vcpu_vmx *) */
+
+	mov VCPU_RAX(%_ASM_DI), %_ASM_CX    /* RCX = in_eax */
+	cmp $0x24, %ecx
+	ja .Lcheck_ext_leaf
+
+	/* CPUID leaves 0x00–0x24 that rely on ECX subleaves: (0x00000019E154A990ULL >> in_eax) & 1 */
+	cmp $0x1F, %ecx
+	ja .Lleaf_above_1F
+	mov $0xE154A990, %_ASM_DX
+	jmp .Lrotate_leaf_mask
+.Lleaf_above_1F:
+	sub $0x20, %_ASM_CX
+	mov $0x00000019, %_ASM_DX
+
+.Lrotate_leaf_mask:
+	shr %cl, %_ASM_DX
+	and $1, %_ASM_DX
+	jnz .Lsubleaf_indexed
+
+	xor %_ASM_CX, %_ASM_CX              /* in_ecx = 0 */
+	jmp .Lfetch_cache_entry
+
+.Lsubleaf_indexed:
+	mov VCPU_RCX(%_ASM_DI), %_ASM_CX    /* RCX = in_ecx */
+	cmp $0x3F, %_ASM_CX
+	jbe .Lfetch_cache_entry
+	mov $0x3F, %_ASM_CX                 /* in_ecx = min(in_ecx, 0x3F) */
+
+.Lfetch_cache_entry:
+	/* Index = (in_eax * 64 + in_ecx) * 20 */
+	mov VCPU_RAX(%_ASM_DI), %_ASM_DX    /* RDX = in_eax */
+	shl $6, %edx
+	add %ecx, %edx
+	imul $20, %edx, %edx
+	lea OFFSET_KVM_VCPU_CPUID_CACHE(%_ASM_SI, %_ASM_DX, 1), %_ASM_SI
+	jmp .Lverify_and_write
+
+
+.Lcheck_ext_leaf:
+	mov VCPU_RAX(%_ASM_DI), %_ASM_DX    /* RDX = in_eax */
+	cmp $0x80000000, %edx
+	jb .Lfastpath_slowpath
+	cmp $0x80000007, %edx
+	ja .Lfastpath_slowpath
+
+	xor %_ASM_CX, %_ASM_CX              /* in_ecx = 0 */
+
+	/* Index = (in_eax * 64 + in_ecx) * 20 */
+	sub $0x80000000, %edx               /* RDX = in_eax - 0x80000000 */
+	shl $6, %edx
+	add %ecx, %edx
+	imul $20, %edx, %edx
+	lea OFFSET_KVM_VCPU_EXT_CPUID_CACHE(%_ASM_SI, %_ASM_DX, 1), %_ASM_SI
+
+
+.Lverify_and_write:
+	/* Verify rdy == 1 */
+	cmpl $1, 0(%_ASM_SI)
+	jne .Lfastpath_slowpath
+
+	/* Cache hit: Write EAX, EBX, ECX, EDX into vcpu->arch.regs */
+	mov 4(%_ASM_SI),  %edx
+	mov %_ASM_DX, VCPU_RAX(%_ASM_DI)
+	mov 8(%_ASM_SI),  %edx
+	mov %_ASM_DX, VCPU_RBX(%_ASM_DI)
+	mov 12(%_ASM_SI),  %edx
+	mov %_ASM_DX, VCPU_RCX(%_ASM_DI)
+	mov 16(%_ASM_SI),  %edx
+	mov %_ASM_DX, VCPU_RDX(%_ASM_DI)
+
+.Ladvance_rip_and_reenter:
+	mov $0x440C, %esi                   /* Read VM_EXIT_INSTRUCTION_LEN (VMCS 0x440C) */
+	vmread %_ASM_SI, %_ASM_CX
+	jbe .Lfastpath_slowpath             /* Branches if CF == 1 OR ZF == 1, VMREAD failure */
+	mov $0x681E, %esi                   /* Read GUEST_RIP (VMCS 0x681E) */
+	vmread %_ASM_SI, %_ASM_DX
+	jbe .Lfastpath_slowpath             /* Branches if CF == 1 OR ZF == 1, VMREAD failure */
+
+	add %_ASM_CX, %_ASM_DX
+	vmwrite %_ASM_DX, %_ASM_SI          /* Write GUEST_RIP (VMCS %_ASM_SI) */
+	jbe .Lfastpath_slowpath             /* Branches if CF == 1 OR ZF == 1, VMWRITE failure */
+.Lreload_and_reenter:
+
+	lea -OFFSET_KVM_VCPU_ARCH_REGS(%_ASM_DI), %_ASM_SI      /* RSI = struct vcpu_vmx * (or struct kvm_vcpu *) */
+	mov OFFSET_VCPU_VMX_LOADED_VMCS(%_ASM_SI), %_ASM_DX     /* RDX = vmx->loaded_vmcs (struct loaded_vmcs *) */
+	movb $1, OFFSET_LOADED_VMCS_LAUNCHED(%_ASM_DX)          /* vmx->loaded_vmcs->launched = 1 */
+
+	/* Reload GPRs from &vcpu->arch.regs (%_ASM_DI) */
+#ifdef CONFIG_X86_64
+	mov VCPU_R8 (%_ASM_DI), %r8
+	mov VCPU_R9 (%_ASM_DI), %r9
+	mov VCPU_R10(%_ASM_DI), %r10
+	mov VCPU_R11(%_ASM_DI), %r11
+	mov VCPU_R12(%_ASM_DI), %r12
+	mov VCPU_R13(%_ASM_DI), %r13
+	mov VCPU_R14(%_ASM_DI), %r14
+	mov VCPU_R15(%_ASM_DI), %r15
+#endif
+	mov VCPU_RAX(%_ASM_DI), %_ASM_AX
+	mov VCPU_RCX(%_ASM_DI), %_ASM_CX
+	mov VCPU_RDX(%_ASM_DI), %_ASM_DX
+	mov VCPU_RBX(%_ASM_DI), %_ASM_BX
+	mov VCPU_RBP(%_ASM_DI), %_ASM_BP
+	mov VCPU_RSI(%_ASM_DI), %_ASM_SI
+	mov VCPU_RDI(%_ASM_DI), %_ASM_DI    /* MUST BE LAST: Reload guest RDI from memory (overwriting our @regs pointer) */
+
+	/* Execute VMRESUME to return directly to guest execution loop */
+	jmp .Lvmresume
+
+.Lcheck_msr_range:
+	mov VCPU_RCX(%_ASM_DI), %_ASM_DX    /* RDX = guest ECX (MSR index) */
+	cmp $0x1FFF, %edx                   /* Check Low Range: 0x00000000 - 0x00001FFF */
+	jbe .Lfastpath_slowpath
+	cmp $0xC0000000, %edx               /* Check below High Range: 0x00002000 - 0xBFFFFFFF */
+	jb .Linject_gp
+	cmp $0xC0001FFF, %edx               /* Check High Range: 0xC0000000 - 0xC0001FFF */
+	jbe .Lfastpath_slowpath
+
+.Linject_gp:
+	mov $0x4018, %esi                   /* Write VM_ENTRY_EXCEPTION_ERROR_CODE (VMCS 0x4018) */
+	xor %_ASM_DX, %_ASM_DX
+	vmwrite %_ASM_DX, %_ASM_SI
+	jbe .Lfastpath_slowpath             /* Branches if CF == 1 OR ZF == 1, VMWRITE failure */
+
+	mov $0x4016, %esi                   /* Write VM_ENTRY_INTR_INFO_FIELD (VMCS 0x4016) */
+	mov $0x80000B0D, %_ASM_DX           /* Set Vector 13 (#GP) | Interruption Type 3 (Hardware Exception) | Deliver Error Code (Bit 11) | Valid (Bit 31) */
+	vmwrite %_ASM_DX, %_ASM_SI
+//	jbe .Lfastpath_slowpath             /* Branches if CF == 1 OR ZF == 1, VMWRITE failure */
+//	jmp .Lreload_and_reenter
+	ja .Lreload_and_reenter             /* Branches if CF == 0 AND ZF == 0, VMWRITE success */
+
+.Lfastpath_slowpath:
+#endif  // NIKA end
+
 	/* Clear return value to indicate VM-Exit (as opposed to VM-Fail). */
 	xor %ebx, %ebx
 
--- a/arch/x86/kvm/vmx/vmx.c	2026-04-22 12:30:53.000000000 +0100
+++ b/arch/x86/kvm/vmx/vmx.c	2026-09-04 00:24:02.541385457 +0100
@@ -76,6 +76,61 @@
 
 #include "mmu/spte.h"
 
+struct host_ds_area {  // NIKA begin
+	u64 bts_buffer_base;
+	u64 bts_index;
+	u64 bts_absolute_maximum;
+	u64 bts_interrupt_threshold;
+	u64 pebs_buffer_base;
+	u64 pebs_index;
+	u64 pebs_absolute_maximum;
+	u64 pebs_interrupt_threshold;
+	u64 pebs_counter_reset[4];
+} __attribute__((packed));  // NIKA end
+
+struct host_ds_env {  // NIKA begin
+	struct host_ds_area *ds_area;
+	void *bts_buffer;
+};  // NIKA end
+
+/* Allocates one instance of struct host_ds_env for every logical CPU core */
+static DEFINE_PER_CPU(struct host_ds_env, ds_env_on_cpu);  // NIKA added
+
+int create_dummy_ds_area(struct host_ds_env *ds_env)  // NIKA begin
+{
+	// 1. Allocate 1 page for the BTS trace records
+	ds_env->bts_buffer = (void *)__get_free_page(GFP_KERNEL | __GFP_ZERO);
+	if (!ds_env->bts_buffer)
+		return -ENOMEM;
+	// 2. Allocate the DS Save Area configuration structure
+	ds_env->ds_area = kzalloc(sizeof(struct host_ds_area), GFP_KERNEL);
+	if (!ds_env->ds_area) {
+		free_page((unsigned long)ds_env->bts_buffer);
+		return -ENOMEM;
+	}
+	// 3. Configure the bounds to create a silent, wrapping circular buffer
+	ds_env->ds_area->bts_buffer_base = (u64)ds_env->bts_buffer;
+	ds_env->ds_area->bts_index = (u64)ds_env->bts_buffer;
+	ds_env->ds_area->bts_absolute_maximum = (u64)ds_env->bts_buffer + PAGE_SIZE;
+	ds_env->ds_area->bts_interrupt_threshold = (u64)ds_env->bts_buffer + PAGE_SIZE + 1;
+	// 4. Write the linear address to the hardware MSR
+	wrmsrq(0x600, (u64)ds_env->ds_area);  // MSR_IA32_DS_AREA
+	return 0;
+}  // NIKA end
+
+void destroy_dummy_ds_area(struct host_ds_env *ds_env)  // NIKA begin
+{
+	wrmsrq(0x600, 0);  // MSR_IA32_DS_AREA
+	if (ds_env->ds_area) {
+		kfree(ds_env->ds_area);
+		ds_env->ds_area = NULL;
+	}
+	if (ds_env->bts_buffer) {
+		free_page((unsigned long)ds_env->bts_buffer);
+		ds_env->bts_buffer = NULL;
+	}
+}  // NIKA end
+
