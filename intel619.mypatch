+//	guest_id = (((u64)HV_LINUX_VENDOR_ID) << 48);  // NIKA removed
+	guest_id = (((u64)0x0001) << 48);  // Vendor:Microsoft
+	guest_id |= (((u64)0x04) << 40);  // OS:WindowsNT
+	guest_id |= (((u64)0x0A) << 32);  // Major:10
+	guest_id |= (((u64)0x00) << 24);  // Minor:0
+//	guest_id |= (kernel_version << 16);  // NIKA removed
+	guest_id |= (((u64)0x00) << 16);  // Service:0
+	guest_id |= 0x4A61;  // Build:19041
 
 	return guest_id;
 }
