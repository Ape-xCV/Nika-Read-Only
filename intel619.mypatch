--- a/arch/x86/kvm/kvm-asm-offsets.c	2026-04-22 12:30:53.000000000 +0100
+++ b/arch/x86/kvm/kvm-asm-offsets.c	2026-10-08 19:30:09.346785995 +0100
@@ -6,12 +6,24 @@
  */
 #define COMPILE_OFFSETS
 
+#include <linux/kvm_host.h>  // NIKA added
 #include <linux/kbuild.h>
 #include "vmx/vmx.h"
 #include "svm/svm.h"
 
 static void __used common(void)
 {
+	OFFSET(OFFSET_KVM_VCPU_arch_regs, kvm_vcpu, arch.regs);  // NIKA added
+	OFFSET(OFFSET_KVM_VCPU_arch_cr2, kvm_vcpu, arch.cr2);  // NIKA added
+	OFFSET(OFFSET_KVM_VCPU_kvm, kvm_vcpu, kvm);  // NIKA added
