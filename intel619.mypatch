@@ -4343,6 +4354,21 @@
 int kvm_get_msr_common(struct kvm_vcpu *vcpu, struct msr_data *msr_info)
 {
 	switch (msr_info->index) {
+	case 0xC80:  /* MSR_IA32_DEBUG_INTERFACE */
+		msr_info->data = 1ULL << 30;  /* Set LOCK (bit 30) */
+		break;
+	case 0xDB0:  /* MSR_IA32_PM_CTL0 */
+	case 0xDB1:  /* MSR_IA32_PM_CTL1 */
+	case 0xDB2:  /* MSR_IA32_THREAD_STALL */
+	case 0x19A:  /* MSR_IA32_CLOCK_MODULATION */
+	case 0x19B:  /* MSR_IA32_THERM_INTERRUPT */
+	case 0x19C:  /* MSR_IA32_THERM_STATUS */
+	case 0x19D:  /* MSR_IA32_THERM2_CTL */
+	case 0x390:  /* MSR_IA32_PERF_GLOBAL_STATUS_RESET */
+	case 0x391:  /* MSR_IA32_PERF_GLOBAL_STATUS_SET */
+	case 0x982:  /* MSR_IA32_TME_ACTIVATE */
+		msr_info->data = 0;
+		break;
 	case MSR_IA32_PLATFORM_ID:
 	case MSR_IA32_EBL_CR_POWERON:
 	case MSR_IA32_LASTBRANCHFROMIP:
@@ -9234,7 +9260,14 @@
 		kvm_run->exit_reason = KVM_EXIT_DEBUG;
 		return 0;
 	}
-	kvm_queue_exception_p(vcpu, DB_VECTOR, DR6_BS);
+	unsigned long next_rip = kvm_get_linear_rip(vcpu);  // NIKA begin
+	unsigned long dr6_payload = 0;
+	if (vcpu->arch.db[0] == next_rip && (vcpu->arch.dr7 & 0x03)) dr6_payload |= DR_TRAP0;
+	if (vcpu->arch.db[1] == next_rip && (vcpu->arch.dr7 & 0x0C)) dr6_payload |= DR_TRAP1;
+	if (vcpu->arch.db[2] == next_rip && (vcpu->arch.dr7 & 0x30)) dr6_payload |= DR_TRAP2;
+	if (vcpu->arch.db[3] == next_rip && (vcpu->arch.dr7 & 0xC0)) dr6_payload |= DR_TRAP3;
+	kvm_queue_exception_p(vcpu, DB_VECTOR, DR6_BS | dr6_payload);  // NIKA end
+//	kvm_queue_exception_p(vcpu, DB_VECTOR, DR6_BS);  // NIKA removed
 	return 1;
 }
 
