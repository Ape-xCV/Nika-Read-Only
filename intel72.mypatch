 	vmx_disable_fb_clear(vmx);
 
 	if (vcpu->arch.cr2 != native_read_cr2())
 		native_write_cr2(vcpu->arch.cr2);
 
+for (;;) {  // NIKA added
 	vmx->fail = __vmx_vcpu_run(vmx, flags);
 
 	vcpu->arch.cr2 = native_read_cr2();
@@ -7494,10 +7525,69 @@
 	}
 
 	vmx->vt.exit_reason.full = vmcs_read32(VM_EXIT_REASON);
+	if (vmx->vt.exit_reason.basic == EXIT_REASON_CPUID) {  // NIKA begin
+		if (!vcpu->kvm->unintercept_cpuid && rdtsc() - vcpu->kvm->segment_timestamp > 145152000000)  // Intel® Core™ processors >60 seconds
+			vcpu->kvm->unintercept_cpuid = true;
+		if (vcpu->kvm->unintercept_cpuid) {
+			bool cpuid_fault_enabled = (vcpu->arch.msr_misc_features_enables & BIT_ULL(0)) ||  // MSR_MISC_FEATURES_ENABLES_CPUID_FAULT
+									   (vcpu->arch.msr_hwcr & BIT_ULL(35));                    // MSR_K7_HWCR_CPUID_USER_DIS
+			if (cpuid_fault_enabled && vmx_get_cpl(vcpu) > 0)
+				goto cpuid_fault;
+			// CHECK: GUEST_RFLAGS for TF (single-stepping)
+			if (!report_ignored_msrs && (vmcs_readl(GUEST_RFLAGS) & X86_EFLAGS_TF))
+				goto cpuid_fault;
+			u32 function = kvm_rax_read(vcpu);
+			u32 index = kvm_rcx_read(vcpu);
+			struct kvm_cpuid_entry2 *entry = NULL;  // Direct, noinstr-safe lookup
+			for (int i = 0; i < vcpu->arch.cpuid_nent; i++) {
+				if (vcpu->arch.cpuid_entries[i].function == function
+				    && (vcpu->arch.cpuid_entries[i].index == index || !(vcpu->arch.cpuid_entries[i].flags & KVM_CPUID_FLAG_SIGNIFCANT_INDEX))) {
+					entry = &vcpu->arch.cpuid_entries[i];
+					break;
+				}
+			}
+			if (report_ignored_msrs && function >= 0x40000000 && function <= 0x4000000B) {
+				if (vcpu->hv_cpuid_cache[0x00][0x00].rdy == 1) function = min(function, vcpu->hv_cpuid_cache[0x00][0x00].eax);
+				else                                           function = min(function, 0x4000000B);
+				index = 0;
+				function -= 0x40000000;
+				vcpu->arch.regs[VCPU_REGS_RAX] = vcpu->hv_cpuid_cache[function][index].eax;
+				vcpu->arch.regs[VCPU_REGS_RBX] = vcpu->hv_cpuid_cache[function][index].ebx;
+				vcpu->arch.regs[VCPU_REGS_RCX] = vcpu->hv_cpuid_cache[function][index].ecx;
+				vcpu->arch.regs[VCPU_REGS_RDX] = vcpu->hv_cpuid_cache[function][index].edx;
+				function += 0x40000000;
+			}
+			else if (entry) {
+				if (report_ignored_msrs && function == 0x01) entry->ecx |= 1U << 31;  // Hyper-V fix
+				vcpu->arch.regs[VCPU_REGS_RAX] = entry->eax;
+				vcpu->arch.regs[VCPU_REGS_RBX] = entry->ebx;
+				vcpu->arch.regs[VCPU_REGS_RCX] = entry->ecx;
+				vcpu->arch.regs[VCPU_REGS_RDX] = entry->edx;
+			}
+			else goto cpuid_fault;
+			kvm_register_mark_dirty(vcpu, VCPU_REGS_RAX);
+			kvm_register_mark_dirty(vcpu, VCPU_REGS_RBX);
+			kvm_register_mark_dirty(vcpu, VCPU_REGS_RCX);
+			kvm_register_mark_dirty(vcpu, VCPU_REGS_RDX);
+		//	kvm_rax_write(vcpu, entry->eax);
+		//	kvm_rbx_write(vcpu, entry->ebx);
+		//	kvm_rcx_write(vcpu, entry->ecx);
+		//	kvm_rdx_write(vcpu, entry->edx);
+			u32 instr_len = vmcs_read32(VM_EXIT_INSTRUCTION_LEN);
+			unsigned long rip = vmcs_readl(GUEST_RIP);
+			vmcs_writel(GUEST_RIP, rip + instr_len);
+			vcpu->arch.rip = rip + instr_len;
+			vmx_disable_fb_clear(vmx);
+			continue;
+		}
+	}
+cpuid_fault:  // NIKA end
 	if (likely(!vmx_get_exit_reason(vcpu).failed_vmentry))
 		vmx->idt_vectoring_info = vmcs_read32(IDT_VECTORING_INFO_FIELD);
 
 	vmx_handle_nmi(vcpu);
+	break;  // NIKA added
+}  // NIKA added
 
